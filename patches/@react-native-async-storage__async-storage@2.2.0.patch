--- /dev/null
+++ b/android/src/main/java/com/reactnativecommunity/asyncstorage/LargeValueReader.java
@@ -0,0 +1,149 @@
+/* Licensed under the MIT license; see LICENSE in this package. */
+package com.reactnativecommunity.asyncstorage;
+
+import android.database.AbstractWindowedCursor;
+import android.database.Cursor;
+import android.database.CursorWindow;
+import android.database.sqlite.SQLiteBlobTooBigException;
+import android.database.sqlite.SQLiteDatabase;
+import android.database.sqlite.SQLiteException;
+import android.os.Build;
+import com.facebook.react.bridge.Arguments;
+import com.facebook.react.bridge.ReadableArray;
+import com.facebook.react.bridge.WritableArray;
+import java.nio.ByteBuffer;
+import java.nio.CharBuffer;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.CoderResult;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.CharsetDecoder;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Bounded, SELECT-only compatibility read for legacy rows that exceed CursorWindow. */
+final class LargeValueReader {
+  static final int SLICE_BYTES = 512 * 1024;
+  static final int MAX_VALUE_BYTES = 8 * 1024 * 1024;
+  static final int MAX_TOTAL_BYTES = 16 * 1024 * 1024;
+
+  private LargeValueReader() {}
+
+  static void requireCurrentRow(Cursor cursor) {
+    // Android 24–27 counts a row that did not fit, then reports a successful move
+    // with an empty window. AOSP added SQLITE_TOOBIG for this case in Android 28.
+    // Detect that precise state before getString; do not reinterpret arbitrary
+    // IllegalStateException (a closed cursor/database must remain an error).
+    if (Build.VERSION.SDK_INT < 28 && cursor instanceof AbstractWindowedCursor) {
+      CursorWindow window = ((AbstractWindowedCursor) cursor).getWindow();
+      if (window != null && window.getNumRows() == 0) {
+        throw new SQLiteBlobTooBigException("Legacy row does not fit into CursorWindow");
+      }
+    }
+  }
+
+  static WritableArray read(SQLiteDatabase database, ReadableArray keys)
+      throws CharacterCodingException {
+    database.acquireReference();
+    try {
+      if (database.inTransaction()) {
+        throw new SQLiteException("Cannot recover a value inside an existing transaction");
+      }
+      // Same database and worker thread, with no supplier monitor or extra handle.
+      // IMMEDIATE prevents any other module instance from changing later slices.
+      database.beginTransactionNonExclusive();
+      try {
+        return readSnapshot(database, keys);
+      } finally {
+        // SELECT-only: rollback releases the snapshot even if assembly failed.
+        database.endTransaction();
+      }
+    } finally {
+      database.releaseReference();
+    }
+  }
+
+  private static WritableArray readSnapshot(SQLiteDatabase database, ReadableArray keys)
+      throws CharacterCodingException {
+    try (Cursor encoding = database.rawQuery("PRAGMA encoding", null)) {
+      if (!encoding.moveToFirst() || !"UTF-8".equalsIgnoreCase(encoding.getString(0))) {
+        throw new SQLiteException("Legacy value recovery requires UTF-8 storage");
+      }
+    }
+    Map<String, Integer> lengths = new LinkedHashMap<>();
+    long total = 0;
+    // Preflight all distinct values before allocating a large buffer. Upstream
+    // returns one row per distinct key, including one null for a missing key.
+    for (int index = 0; index < keys.size(); index++) {
+      String key = keys.getString(index);
+      if (key == null) throw new SQLiteException("Invalid AsyncStorage key");
+      if (lengths.containsKey(key)) continue;
+      try (Cursor metadata = database.rawQuery(
+          "SELECT typeof(value), length(CAST(value AS BLOB)) FROM catalystLocalStorage WHERE key = ?",
+          new String[] {key})) {
+        if (!metadata.moveToFirst()) {
+          lengths.put(key, -1);
+          continue;
+        }
+        if (!"text".equals(metadata.getString(0)) || metadata.isNull(1)) {
+          throw new SQLiteException("Invalid legacy AsyncStorage value type");
+        }
+        long length = metadata.getLong(1);
+        if (length < 0 || length > MAX_VALUE_BYTES || total + length > MAX_TOTAL_BYTES) {
+          throw new SQLiteException("Legacy saved data exceeds the bounded recovery limit; data is kept");
+        }
+        total += length;
+        lengths.put(key, (int) length);
+      }
+    }
+    WritableArray data = Arguments.createArray();
+    for (Map.Entry<String, Integer> entry : lengths.entrySet()) {
+      String key = entry.getKey();
+      int length = entry.getValue();
+      WritableArray row = Arguments.createArray();
+      row.pushString(key);
+      if (length < 0) {
+        row.pushNull();
+      } else {
+        byte[] bytes = new byte[length];
+        for (int offset = 0; offset < length; offset += SLICE_BYTES) {
+          int count = Math.min(SLICE_BYTES, length - offset);
+          try (Cursor slice = database.rawQuery(
+              "SELECT substr(CAST(value AS BLOB), CAST(? AS INTEGER), CAST(? AS INTEGER)) "
+                  + "FROM catalystLocalStorage WHERE key = ?",
+              new String[] {Integer.toString(offset + 1), Integer.toString(count), key})) {
+            if (!slice.moveToFirst() || slice.isNull(0)) {
+              throw new SQLiteException("Missing legacy value slice; data is kept");
+            }
+            byte[] piece = slice.getBlob(0);
+            if (piece.length != count) {
+              throw new SQLiteException("Incomplete legacy value slice; data is kept");
+            }
+            System.arraycopy(piece, 0, bytes, offset, count);
+          }
+        }
+        validateUtf8(bytes);
+        row.pushString(new String(bytes, StandardCharsets.UTF_8));
+      }
+      data.pushArray(row);
+    }
+    return data;
+  }
+
+  private static void validateUtf8(byte[] bytes) throws CharacterCodingException {
+    CharsetDecoder decoder = StandardCharsets.UTF_8.newDecoder()
+        .onMalformedInput(CodingErrorAction.REPORT)
+        .onUnmappableCharacter(CodingErrorAction.REPORT);
+    ByteBuffer input = ByteBuffer.wrap(bytes);
+    CharBuffer scratch = CharBuffer.allocate(4096);
+    while (true) {
+      CoderResult result = decoder.decode(input, scratch, true);
+      if (result.isError()) result.throwException();
+      if (result.isUnderflow()) break;
+      scratch.clear();
+    }
+    scratch.clear();
+    CoderResult result = decoder.flush(scratch);
+    if (result.isError()) result.throwException();
+  }
+}
